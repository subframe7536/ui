{
  "name": "@subframe7536/ui",
  "version": "0.1.0",
  "description": "SolidJS 2 native UI SDK — API-compatible with @ui-sdk/solid, built directly on Solid 2 signals without a framework-agnostic kernel.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/ui.git"
  },
  "keywords": [
    "solid",
    "solid-js",
    "solid-2",
    "ui",
    "ui-sdk",
    "headless",
    "unstyled",
    "accessibility",
    "a11y",
    "aria",
    "components",
    "agents"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/solid/index.js",
      "default": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "solid": "./dist/solid/accordion.jsx",
      "default": "./dist/accordion.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "solid": "./dist/solid/agent.js",
      "default": "./dist/agent.js"
    },
    "./alert-dialog": {
      "types": "./dist/alert-dialog.d.ts",
      "solid": "./dist/solid/alert-dialog.jsx",
      "default": "./dist/alert-dialog.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "solid": "./dist/solid/button.jsx",
      "default": "./dist/button.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible.d.ts",
      "solid": "./dist/solid/collapsible.jsx",
      "default": "./dist/collapsible.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "solid": "./dist/solid/dialog.jsx",
      "default": "./dist/dialog.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "solid": "./dist/solid/label.jsx",
      "default": "./dist/label.js"
    },
    "./observe": {
      "types": "./dist/observe.d.ts",
      "solid": "./dist/solid/observe.js",
      "default": "./dist/observe.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "solid": "./dist/solid/popover.jsx",
      "default": "./dist/popover.js"
    },
    "./primitive": {
      "types": "./dist/primitive.d.ts",
      "solid": "./dist/solid/primitive.js",
      "default": "./dist/primitive.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "solid": "./dist/solid/separator.jsx",
      "default": "./dist/separator.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "solid": "./dist/solid/switch.jsx",
      "default": "./dist/switch.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "solid": "./dist/solid/tabs.jsx",
      "default": "./dist/tabs.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "solid": "./dist/solid/toggle.jsx",
      "default": "./dist/toggle.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "2.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "solid-js": "2.0.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
